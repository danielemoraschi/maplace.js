{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "useEditorconfig": true,
    "lineWidth": 100
  },
  "linter": {
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "error"
      },
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 300
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/maplace/src/**", "!packages/maplace/src/google/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "google": "Only maplace/google (src/google/) may use google.maps."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/maplace/examples/*/vanilla.html",
        "packages/maplace/examples/*/react.html"
      ],
      "linter": {
        "rules": {
          "style": { "useTemplate": "off" },
          "suspicious": { "noAssignInExpressions": "off", "noAsyncPromiseExecutor": "off" }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true
  }
}
