{
  "name": "maplace",
  "version": "0.0.0",
  "private": true,
  "description": "A list of locations becomes a map plus a synced list, in a few lines.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielemoraschi/maplace.js.git",
    "directory": "packages/maplace"
  },
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/element/index.js",
    "./dist/element/google.js"
  ],
  "exports": {
    ".": {
      "maplace:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./google": {
      "maplace:source": "./src/google/index.ts",
      "types": "./dist/google/index.d.ts",
      "default": "./dist/google/index.js"
    },
    "./element": {
      "maplace:source": "./src/element/index.ts",
      "types": "./dist/element/index.d.ts",
      "default": "./dist/element/index.js"
    },
    "./element/google": {
      "maplace:source": "./src/element/google.ts",
      "types": "./dist/element/google.d.ts",
      "default": "./dist/element/google.js"
    },
    "./react": {
      "maplace:source": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "2.6.2"
  },
  "peerDependencies": {
    "@types/google.maps": "^3.66.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/google.maps": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
