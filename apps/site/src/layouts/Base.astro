---
import "@fontsource/bricolage-grotesque/800.css";
import "@fontsource-variable/instrument-sans";
import "@fontsource-variable/jetbrains-mono";
import "../styles/site.css";
// Imported, not in public/: the build names it by its content, so a new icon is a new URL and no
// browser keeps showing the old one.
import faviconUrl from "../assets/favicon.svg?no-inline";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { CONSENT_GRANTED, CONSENT_KEY } from "../consent/consent-store.ts";
import { LLMS_TXT_ROUTE } from "../site/agent-links.ts";
import { markdownAddressAt } from "../site/markdown-routes.ts";
import { AGENT_SKILLS_INDEX_PATH } from "../site/agent-skill-paths.ts";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const ownMarkdown = markdownAddressAt(Astro.url.pathname);
---

<!doctype html>
<html lang="en" data-maps="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {ownMarkdown && <link rel="alternate" type="text/markdown" href={ownMarkdown} />}
    <link rel="describedby" href={LLMS_TXT_ROUTE} />
    <link rel="describedby" href={AGENT_SKILLS_INDEX_PATH} type="application/json" />
    <link rel="icon" href={faviconUrl} type="image/svg+xml" />
    {/* Before the first paint, so a returning visitor's placeholders never show. */}
    <script is:inline define:vars={{ key: CONSENT_KEY, granted: CONSENT_GRANTED }}>
      try {
        if (localStorage.getItem(key) === granted) document.documentElement.dataset.maps = "on";
      } catch {}
    </script>
  </head>
  {/* A column at least the screen's height, so a short page's footer still sits at the bottom. */}
  <body class="flex min-h-dvh flex-col">
    <SiteHeader />
    {/* Its own stacking context: a map's z-indexes (Google's run to millions) stay under the header. */}
    <main class="wrap isolate grow"><slot /></main>
    <SiteFooter />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
