---
import {
  type PointMark,
  PROVIDER_POINTS,
  PROVIDERS_CONSENT_HREF,
  PROVIDERS_CONSENT_LEAD,
  PROVIDERS_CONSENT_LINK,
  PROVIDERS_HEADING,
  PROVIDERS_PRIVACY,
} from "../examples/home-page.ts";

/** Each point's mark, drawn in the text's colour on a 16-unit grid. */
const MARKS: Readonly<Record<PointMark, string>> = {
  key: "M7.2 8.8 14 2m-3 3 2 2M8 11a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z",
  shapes: "M2 13 6 3l8 3-3 8Z",
  package: "M2 5l6-3 6 3v6l-6 3-6-3ZM2 5l6 3 6-3M8 8v6",
  route: "M4 12.5C4 8 12 9 12 4.5M4 12.5a1.5 1.5 0 1 1 0 .01M12 4.5a1.5 1.5 0 1 1 0-.01",
  layers: "M8 2l6 3-6 3-6-3ZM2 8l6 3 6-3M2 11l6 3 6-3",
};
---

{/* The two providers side by side (W66), and why a map can wait: on the home page's night band. */}
<section aria-labelledby="providers-title" class="border-t border-ink/15 py-8">
  <h2 id="providers-title" class="headline m-0 text-section leading-[1.06]">{PROVIDERS_HEADING}</h2>
  <div class="mt-10 grid grid-cols-2 rounded-panel border border-ink/15 bg-paper max-[48rem]:grid-cols-1">
    {
      PROVIDER_POINTS.map(({ name, points }, index) => (
        <div class:list={["p-[clamp(1.5rem,4vw,2.5rem)]", index > 0 && "border-s border-ink/15 max-[48rem]:border-s-0 max-[48rem]:border-t"]}>
          <h3 class="m-0 text-lede">{name}</h3>
          <ul class="mt-4 mb-0 grid list-none gap-2.5 p-0">
            {points.map(({ mark, text }) => (
              <li class="flex gap-3">
                <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" class="mt-1 shrink-0 text-muted" aria-hidden="true">
                  <path d={MARKS[mark]} />
                </svg>
                {text}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <p class="mt-6 mb-0 text-muted">
    {PROVIDERS_PRIVACY} {PROVIDERS_CONSENT_LEAD} <a href={PROVIDERS_CONSENT_HREF}>{PROVIDERS_CONSENT_LINK}</a>.
  </p>
</section>
