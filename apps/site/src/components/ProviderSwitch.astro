---
import { FIRST_PROVIDER, PROVIDER_LABELS } from "../examples/example-providers.ts";

interface Props {
  /** Where the page places it. */
  class?: string;
}

const { class: placement } = Astro.props;
---

<fieldset
  data-provider-choice
  class:list={[
    "group/provider relative m-0 grid h-(--spacing-toggle-height) w-(--spacing-toggle-width) shrink-0 grid-cols-2 border-2 border-ink bg-paper p-0 text-sm font-medium",
    placement,
  ]}
>
  <legend class="sr-only">Run the examples on</legend>
  {/* The chosen provider's ground, sliding under the second segment when that one is checked. */}
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-y-0 left-0 w-1/2 bg-ink transition-transform duration-150 ease-out group-has-[label:last-of-type>input:checked]/provider:translate-x-full motion-reduce:transition-none"
  ></span>
  {
    PROVIDER_LABELS.map(({ provider, label }) => (
      <label class="relative cursor-pointer px-3.5 py-1 text-center transition-colors duration-150 has-checked:text-paper has-focus-visible:outline-3 has-focus-visible:outline-offset-2 has-focus-visible:outline-accent motion-reduce:transition-none">
        <input
          class="absolute inset-0 m-0 cursor-[inherit] appearance-none opacity-0"
          type="radio"
          name="provider"
          value={provider}
          checked={provider === FIRST_PROVIDER}
          autocomplete="off"
        />
        {label}
      </label>
    ))
  }
</fieldset>
