---
import { filesAsShown } from "../examples/bootstrap-fold.ts";
import type { ExampleCode } from "../examples/example-sources.ts";
import FoldedHost from "./FoldedHost.astro";
import SourceCode from "./SourceCode.astro";

interface Props {
  /** One version's code on one provider: its files, in the order a reader reads them. */
  version: ExampleCode;
}

const { version } = Astro.props;
---

{
  filesAsShown(version).map(({ file, code, lang, host }) => (
    <figure class="m-0 mb-4">
      {host === undefined ? (
        <SourceCode code={code} lang={lang} />
      ) : (
        <FoldedHost parts={host} lang={lang} />
      )}
      <figcaption class="mt-2 text-xs text-muted">
        examples/{version.folder}/{file}, as the tests run it
      </figcaption>
    </figure>
  ))
}
