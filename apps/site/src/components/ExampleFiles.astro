---
import { foldBootstrap } from "../examples/bootstrap-fold.ts";
import type { ExampleFile } from "../examples/example-sources.ts";
import FoldedHost from "./FoldedHost.astro";
import SourceCode from "./SourceCode.astro";

interface Props {
  /** Its folder in `packages/maplace/examples/`. */
  name: string;
  /** The files of one of its versions, in the order a reader reads them. */
  files: readonly ExampleFile[];
}

const { name, files } = Astro.props;
const shown = files.map((file) => ({ ...file, host: foldBootstrap(name, file) }));
---

{
  shown.map(({ file, code, lang, host }) => (
    <figure class="mx-0 mt-0 mb-4">
      {host === undefined ? (
        <SourceCode code={code} lang={lang} />
      ) : (
        <FoldedHost parts={host} lang={lang} />
      )}
      <figcaption class="mx-0 mt-2 mb-0 text-xs text-muted">
        examples/{name}/{file}, as the tests run it
      </figcaption>
    </figure>
  ))
}
