---
import { getEntry, render } from "astro:content";
import { dataFetchedBy, exampleDataLinks } from "../examples/example-data-links.ts";
import { FIRST_PROVIDER } from "../examples/example-providers.ts";
import type { ExampleSection } from "../examples/example-sections.ts";
import { codeTabsOf, exampleProviders } from "../examples/example-sources.ts";
import { REPO_FILES_ENTRY } from "../site/repo-files-loader.ts";
import ExampleFiles from "./ExampleFiles.astro";
import MapFrame from "./MapFrame.astro";
import VersionSwitch from "./VersionSwitch.astro";

interface Props extends ExampleSection {
  number: number;
}

const { number, name, title, summary, drawsOwnList, googleOnlyBecause } = Astro.props;
const codeTabs = codeTabsOf(name);
// Its code tabs open on the first provider it has: route's Google, the others' the page's first.
const [firstProvider] = exampleProviders(name);
// Without a version on the page's first provider (route on MapLibre), its version radios and code
// tabs open grayed out, until the visitor shows it on Google (`version-switch.ts`).
const offered = firstProvider === FIRST_PROVIDER;
const repoFiles = await getEntry("repoFiles", REPO_FILES_ENTRY);
if (repoFiles === undefined) throw new Error("the repoFiles collection has no entry");
const fetched = dataFetchedBy(
  codeTabs
    .flatMap(({ codes }) => codes)
    .flatMap(({ files }) => files)
    .map(({ code }) => code),
);
const dataLinks = exampleDataLinks(fetched, repoFiles.data.blobBase);
const guide = await getEntry("exampleGuides", name);
const Guide = guide && (await render(guide)).Content;
const tabs = [
  { tab: "map", label: "Map" },
  ...codeTabs.map(({ kind, label }) => ({ tab: kind, label })),
];
// `example-` keeps the site's ids apart from the pages' own (`route-map`).
const panel = (tab: string) => `example-${name}-${tab}`;
---

{/* Its top spacing is `--spacing-toggle-offset` in `theme.css`: change both together. */}
<section
  class="example mt-12 border-t-3 border-ink pt-4"
  id={name}
  aria-labelledby={`${name}-title`}
  data-version-switch={name}
>
  {/* The first section's row leaves room for the page's provider toggle (`index.astro`). */}
  <div
    class:list={[
      "flex flex-wrap items-baseline gap-x-4 gap-y-1",
      number === 1 && "pe-[calc(var(--spacing-toggle-width)+1rem)]",
    ]}
    data-heading-row
  >
    <h2 class="m-0 text-3xl" id={`${name}-title`}>
      <span class="text-accent">{String(number).padStart(2, "0")}</span>{" "}{title}
    </h2>
    <p class="m-0 text-muted">{summary}</p>
  </div>
  {
    dataLinks.length > 0 && (
      <p class="mt-1 mb-0 text-sm text-muted">
        Fetches{" "}
        {dataLinks.map(({ file, url }, index) => (
          <>
            {index > 0 && ", "}
            <a href={url} target="_blank" rel="noopener">{file}</a>
          </>
        ))}
      </p>
    )
  }
  {
    Guide && (
      <div class="example-guide mt-3 max-w-text">
        <Guide />
      </div>
    )
  }
  <div
    class="mt-4 mb-3 flex flex-wrap"
    role="tablist"
    aria-label={`${title}: the map and its code`}
  >
    {
      tabs.map(({ tab, label }, index) => (
        <button
          type="button"
          role="tab"
          class="border-0 bg-transparent px-3.5 py-1 text-sm font-medium aria-selected:bg-ink aria-selected:text-paper disabled:cursor-not-allowed disabled:text-muted disabled:opacity-60"
          id={`${panel(tab)}-tab`}
          aria-controls={panel(tab)}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          disabled={index > 0 && !offered}
        >
          {label}
        </button>
      ))
    }
  </div>
  <div role="tabpanel" id={panel("map")} aria-labelledby={`${panel("map")}-tab`}>
    <VersionSwitch name={name} disabled={!offered} />
    <MapFrame name={name} drawsOwnList={drawsOwnList} googleOnlyBecause={googleOnlyBecause} />
  </div>
  {
    codeTabs.map(({ kind, codes }) => (
      <div role="tabpanel" id={panel(kind)} aria-labelledby={`${panel(kind)}-tab`} hidden>
        {codes.map((code) => (
          <div
            data-provider-files={code.provider}
            hidden={code.provider !== firstProvider}
          >
            <ExampleFiles version={code} />
          </div>
        ))}
      </div>
    ))
  }
</section>
