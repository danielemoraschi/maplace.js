---
import { getEntry } from "astro:content";
import { dataFetchedBy, exampleDataLinks } from "../examples/example-data-links.ts";
import type { ExampleSection } from "../examples/example-sections.ts";
import { exampleCode } from "../examples/example-sources.ts";
import { REPO_FILES_ENTRY } from "../site/repo-files-loader.ts";
import ExampleFiles from "./ExampleFiles.astro";
import MapFrame from "./MapFrame.astro";
import VersionSwitch from "./VersionSwitch.astro";

interface Props extends ExampleSection {
  number: number;
}

const { number, name, title, summary } = Astro.props;
const versions = exampleCode(name);
const repoFiles = await getEntry("repoFiles", REPO_FILES_ENTRY);
if (repoFiles === undefined) throw new Error("the repoFiles collection has no entry");
const fetched = dataFetchedBy(versions.flatMap(({ files }) => files.map(({ code }) => code)));
const dataLinks = exampleDataLinks(fetched, repoFiles.data.blobBase);
const tabs = [
  { tab: "map", label: "Map" },
  ...versions.map(({ kind, label }) => ({ tab: kind, label })),
];
// `example-` keeps the site's ids apart from the pages' own (`route-map`).
const panel = (tab: string) => `example-${name}-${tab}`;
---

<section
  class="example mt-12 border-t-3 border-ink pt-4"
  id={name}
  aria-labelledby={`${name}-title`}
>
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <h2 class="m-0 text-3xl" id={`${name}-title`}>
      <span class="mr-1 text-accent">{String(number).padStart(2, "0")}</span>
      {title}
    </h2>
    <p class="m-0 text-muted">{summary}</p>
  </div>
  {
    dataLinks.length > 0 && (
      <p class="mt-1 mb-0 text-sm text-muted">
        Fetches{" "}
        {dataLinks.map(({ file, url }, index) => (
          <>
            {index > 0 && ", "}
            <a href={url} target="_blank" rel="noopener">{file}</a>
          </>
        ))}
      </p>
    )
  }
  <div
    class="mt-4 mb-3 flex flex-wrap"
    role="tablist"
    aria-label={`${title}: the map and its code`}
  >
    {
      tabs.map(({ tab, label }, index) => (
        <button
          type="button"
          role="tab"
          class="border-0 bg-transparent px-3.5 py-1 text-sm font-medium aria-selected:bg-ink aria-selected:text-paper"
          id={`${panel(tab)}-tab`}
          aria-controls={panel(tab)}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
        >
          {label}
        </button>
      ))
    }
  </div>
  <div role="tabpanel" id={panel("map")} aria-labelledby={`${panel("map")}-tab`}>
    <VersionSwitch name={name} />
    <MapFrame name={name} />
  </div>
  {
    versions.map(({ kind, files }) => (
      <div role="tabpanel" id={panel(kind)} aria-labelledby={`${panel(kind)}-tab`} hidden>
        <ExampleFiles name={name} files={files} />
      </div>
    ))
  }
</section>
