---
import { getEntry, render } from "astro:content";
import { fetchedDataLinks, stylesheetLinks } from "../examples/example-file-links.ts";
import {
  type ExamplePageEntry,
  groupPath,
  pageHeading,
} from "../examples/example-sections.ts";
import { codeTabsOf, exampleStylesheets } from "../examples/example-sources.ts";
import { versionPanelId, versionTabId } from "../examples/example-versions.ts";
import ExampleFileLinks from "./ExampleFileLinks.astro";
import ExampleFiles from "./ExampleFiles.astro";
import MapFrame from "./MapFrame.astro";
import MarkdownLink from "./MarkdownLink.astro";
import ProviderPart from "./ProviderPart.astro";
import ProviderSwitch from "./ProviderSwitch.astro";
import VersionTabs from "./VersionTabs.astro";

interface Props {
  entry: ExamplePageEntry;
}

const { group, section, path, number } = Astro.props.entry;
const { name, title, summary, drawsOwnList, drawsOwnFrame } = section;
const codeTabs = codeTabsOf(name);
const codes = codeTabs.flatMap(({ codes }) => codes);
const dataLinks = fetchedDataLinks(codes);
const styleLinks = stylesheetLinks(exampleStylesheets(codes));
const guide = await getEntry("exampleGuides", name);
const Guide = guide && (await render(guide)).Content;
// `example-` keeps the site's ids apart from the pages' own (`route-map`).
const panelPrefix = `example-${name}`;
---

{/* An example's page's body: its heading, then its map run from a version, that version's code, its guide. */}
<section class="example" id={name} aria-labelledby={`${name}-title`} data-version-switch={name}>
  <p class="mt-0 mb-1 text-sm font-semibold">
    <a href={groupPath(group)}>{group.label}</a>{" "}
    <span aria-hidden="true" class="text-muted">·</span>{" "}
    <span class="text-accent">{number}</span>
  </p>
  <h1 class="mt-0 mb-2 text-title" id={`${name}-title`}>{pageHeading(title)}</h1>
  <p class="mt-0 mb-2 max-w-text text-lg text-muted">{summary}</p>
  <p class="mt-0 mb-0 text-sm"><MarkdownLink route={path} /></p>
  <ExampleFileLinks lead="Fetches" links={dataLinks} />
  <ExampleFileLinks lead="Styled by" links={styleLinks} />
  {/* One control: a tab runs the map from its version and shows that version's code under it. */}
  {/* Spaced apart on one row; on a phone, the switch wraps under the tabs at the start. */}
  <div class="mt-10 mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <VersionTabs codeTabs={codeTabs} label={`Run ${title} from`} panelPrefix={panelPrefix} />
    <ProviderSwitch name={`${name}-provider`} look="pill" />
  </div>
  <MapFrame name={name} drawsOwnList={drawsOwnList} drawsOwnFrame={drawsOwnFrame} />
  {
    codeTabs.map(({ kind, codes }, index) => (
      <div
        role="tabpanel"
        class="mt-4"
        id={versionPanelId(panelPrefix, kind)}
        aria-labelledby={versionTabId(panelPrefix, kind)}
        hidden={index !== 0}
      >
        {codes.map((code) => (
          <ProviderPart provider={code.provider}>
            <ExampleFiles version={code} />
          </ProviderPart>
        ))}
      </div>
    ))
  }
  {
    Guide && (
      <div class="example-guide mt-6 max-w-text">
        <Guide />
      </div>
    )
  }
</section>
