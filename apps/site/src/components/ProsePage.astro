---
import Base from "../layouts/Base.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Base title={`${title} · maplace`} description={description}>
  <article class="prose-page max-w-text pt-8">
    <h1 class="mx-0 mt-0 mb-4 text-title">{title}</h1>
    <p class="mx-0 mt-0 mb-6 text-muted"><slot name="lede" /></p>
    <slot />
  </article>
</Base>
