---
import quickStartMapLibre from "../../../../packages/maplace/examples/quick-start/maplibre/page.html?raw";
import quickStart from "../../../../packages/maplace/examples/quick-start/page.html?raw";
import { REPOSITORY_URL } from "../site/repo-docs.ts";
import SourceCode from "./SourceCode.astro";

/** `owner/repo`, as GitHub names it. */
const REPOSITORY = new URL(REPOSITORY_URL).pathname.slice(1);
---

<div class="relative pt-10 pb-4">
  <svg
    class="absolute top-10 right-0 w-[min(42vw,20rem)] fill-none stroke-accent stroke-12 max-[70rem]:hidden"
    viewBox="0 0 320 180"
    aria-hidden="true"
  >
    <path d="M0 48 H170 L214 92 H320" />
    <path class="stroke-ink" d="M90 180 V126 L134 82 H320" />
    <circle class="fill-paper stroke-ink stroke-5" cx="170" cy="48" r="11" />
  </svg>
  <h1 class="relative m-0 text-hero leading-[0.95]">
    A JavaScript library<br />for Google Maps<br />and MapLibre.
  </h1>
  <p class="relative mt-4 mb-4 text-lg">
    <strong>maplacejs</strong> puts your locations on Google Maps or MapLibre: markers, shapes and, on Google,
    routes, and the list or menu that goes with them, in sync with the map. One script tag, with
    a Maps key on Google and none on MapLibre; npm and React too.
  </p>
  <p class="relative mt-0 mb-6 h-7">
    <a
      class="github-button"
      href={REPOSITORY_URL}
      data-size="large"
      data-show-count="true"
      aria-label={`Star ${REPOSITORY} on GitHub`}>Star on GitHub</a
    >
  </p>
  <div class="overflow-x-auto">
    <p class="mt-0 mb-1 text-sm font-medium">Google Maps</p>
    <SourceCode code={quickStart} lang="html" />
    <p class="mt-4 mb-1 text-sm font-medium">MapLibre, no key</p>
    <SourceCode code={quickStartMapLibre} lang="html" />
  </div>
</div>
