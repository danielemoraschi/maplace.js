---
import quickStartMapLibre from "../../../../packages/maplace/examples/quick-start/maplibre/page.html?raw";
import quickStart from "../../../../packages/maplace/examples/quick-start/page.html?raw";
import { type ExampleGroup, HEADING_TAIL } from "../examples/example-sections.ts";
import { REPOSITORY_URL } from "../site/repo-docs.ts";
import { starButtonShadow } from "../site/star-button-markup.ts";
import SourceCode from "./SourceCode.astro";

interface Props {
  group: ExampleGroup;
}

const { group } = Astro.props;
---

<div class="flow-root pt-10 pb-4">
  <svg
    class="float-right ml-4 w-[min(42vw,20rem)] fill-none stroke-accent stroke-12 max-[70rem]:hidden"
    viewBox="0 0 320 180"
    aria-hidden="true"
  >
    <path d="M0 48 H170 L214 92 H320" />
    <path class="stroke-ink" d="M90 180 V126 L134 82 H320" />
    <circle class="fill-paper stroke-ink stroke-5" cx="170" cy="48" r="11" />
  </svg>
  <h1 class="m-0 text-hero leading-[0.95]">
    <span data-hero-lead>{group.headingLead}</span>{HEADING_TAIL.map((line) => <><br />{line}</>)}.
  </h1>
  <p class="mt-4 mb-4 text-lg" data-hero-intro>{group.intro}</p>
  <p class="mt-0 mb-6 h-7">
    <span data-star-button
      ><template shadowrootmode="open" set:html={starButtonShadow(REPOSITORY_URL)} /><a
        href={REPOSITORY_URL}>GitHub</a
      ></span
    >
  </p>
  <div class="overflow-x-auto">
    <p class="mt-0 mb-1 text-sm font-medium">Google Maps</p>
    <SourceCode code={quickStart} lang="html" />
    <p class="mt-4 mb-1 text-sm font-medium">MapLibre, no key</p>
    <SourceCode code={quickStartMapLibre} lang="html" />
  </div>
</div>
