---
import quickStart from "../../../../packages/maplace/examples/quick-start/page.html?raw";
import SourceCode from "./SourceCode.astro";
---

<div class="relative pt-10 pb-4">
  <svg
    class="absolute top-0 right-0 w-[min(42vw,20rem)] fill-none stroke-accent stroke-12 max-[640px]:hidden"
    viewBox="0 0 320 180"
    aria-hidden="true"
  >
    <path d="M0 48 H170 L214 92 H320" />
    <path class="stroke-ink" d="M90 180 V126 L134 82 H320" />
    <circle class="fill-paper stroke-ink stroke-5" cx="170" cy="48" r="11" />
  </svg>
  <h1 class="relative m-0 text-hero leading-[0.95]">Places in.<br />Map and list,<br />in sync.</h1>
  <p class="relative mt-4 mb-6 max-w-[34rem] text-lg">
    Click a marker and the list follows. Pick a place in the list and the map pans to it. One
    element, no build step.
  </p>
  <div class="overflow-x-auto">
    <SourceCode code={quickStart} lang="html" />
  </div>
</div>
