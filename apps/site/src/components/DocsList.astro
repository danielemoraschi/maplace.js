---
import { docRoute, REPO_DOCS } from "../site/repo-docs.ts";

interface Props {
  /** The id of the doc shown. */
  current: string;
}

const { current } = Astro.props;
---

<ul class="m-0 list-none border-l-3 border-ink pl-4 text-sm leading-[2]">
  {
    REPO_DOCS.map(({ id, label }) => (
      <li>
        <a
          href={docRoute(id)}
          aria-current={id === current ? "page" : undefined}
          class="no-underline aria-[current=page]:font-semibold aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-3"
        >
          {label}
        </a>
      </li>
    ))
  }
</ul>
