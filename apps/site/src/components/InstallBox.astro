---
import { getEntry } from "astro:content";
import LabelledCode from "./LabelledCode.astro";

const entry = await getEntry("install", "element");
if (entry === undefined) throw new Error("the install collection has no element entry");
const { version, providers } = entry.data;
/** One provider per column, Google's then MapLibre's; one under the other on a phone. */
const PAIR = "grid grid-cols-2 gap-x-6 max-[720px]:grid-cols-1";
/** The row that folds the box, its sign on the right; folded until opened, on every screen. */
const SUMMARY =
  "flex cursor-pointer list-none items-baseline gap-3 [&::-webkit-details-marker]:hidden";
---

<details class="group border-t-3 border-ink pt-4">
  <summary class={SUMMARY}>
    <h2 class="m-0 text-xl">Install</h2>
    <span class="text-sm text-muted">npm and CDN script</span>
    <span
      aria-hidden="true"
      class="ml-auto text-xl after:content-['+'] group-open:after:content-['−']"
    ></span>
  </summary>
  <div class="mt-3">
    <div class={PAIR}>
      {
        providers.map(({ provider, label, npmCommand }) => (
          <LabelledCode id={`npm-install-${provider}`} label={label} text={npmCommand} />
        ))
      }
    </div>
    <h2 class="mt-2 mb-2 text-xl">CDN script</h2>
    <div class={PAIR}>
      {
        providers.map(({ provider, label, cdnSnippet }) => (
          <LabelledCode id={`pinned-script-${provider}`} label={label} text={cdnSnippet} />
        ))
      }
    </div>
    <p class="m-0 text-sm text-muted">Maplace.js {version}, checked by the browser against its hash.</p>
  </div>
</details>
