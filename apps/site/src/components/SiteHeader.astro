---
import { docRoute, REPO_DOCS, REPOSITORY_URL } from "../site/repo-docs.ts";

const here = Astro.url.pathname;
const NAV_LINK = "border-b-3 border-transparent no-underline aria-[current=page]:border-accent";
---

<header class="border-b-3 border-ink">
  <div class="wrap flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 py-3.5">
    <a class="font-display text-2xl leading-none font-extrabold tracking-[-0.03em] no-underline" href="/">
      maplace
    </a>
    <nav aria-label="Documentation" class="flex flex-wrap gap-x-5 gap-y-1 text-md font-medium">
      {
        REPO_DOCS.map(({ id, label }) => (
          <a
            href={docRoute(id)}
            aria-current={here === docRoute(id) ? "page" : undefined}
            class={NAV_LINK}
          >
            {label}
          </a>
        ))
      }
      <a href={REPOSITORY_URL} class={NAV_LINK}>GitHub</a>
    </nav>
  </div>
</header>
