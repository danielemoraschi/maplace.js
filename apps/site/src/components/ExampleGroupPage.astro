---
import { getEntry, render } from "astro:content";
import {
  EXAMPLE_GROUPS,
  type ExampleGroup,
  groupDescription,
  groupHeading,
  groupPath,
  neighbourGroups,
  sectionLabel,
} from "../examples/example-sections.ts";
import Base from "../layouts/Base.astro";
import ExampleSection from "./ExampleSection.astro";
import MarkdownLink from "./MarkdownLink.astro";
import PageColumns from "./PageColumns.astro";

interface Props {
  group: ExampleGroup;
}

const { group } = Astro.props;
const reference = await getEntry("groupReferences", group.id);
if (reference === undefined) throw new Error(`the groupReferences collection has no ${group.id}`);
const { Content: References } = await render(reference);
const links = EXAMPLE_GROUPS.map((each) => ({ href: groupPath(each), label: each.label }));
const onThisPage = [
  ...group.sections.map(({ name, title }) => ({ slug: name, text: title })),
  { slug: "reference", text: "Reference" },
];
const { previous, next } = neighbourGroups(group);
const NEIGHBOUR = "flex flex-col gap-1 no-underline";
---

{/* A feature's page (D31): its examples, then the reference tables cut from the docs. */}
<Base heading={groupHeading(group)} description={groupDescription(group)}>
  <PageColumns
    navLabel="Examples"
    links={links}
    current={groupPath(group)}
    onThisPage={onThisPage}
    fold="wide"
  >
    <article class="min-w-0">
      <h1 class="mt-0 mb-2 text-title">{groupHeading(group)}</h1>
      <p class="mt-0 mb-2 max-w-text text-lg text-muted">{group.intro}</p>
      <p class="mt-0 mb-0 text-sm"><MarkdownLink route={groupPath(group)} /></p>
      {
        group.sections.map((section) => (
          <ExampleSection numberLabel={sectionLabel(section)} {...section} />
        ))
      }
      <section
        id="reference"
        aria-labelledby="reference-title"
        class="doc-content mt-12 max-w-text border-t-3 border-ink pt-4"
      >
        <h2 id="reference-title" class="mt-0">Reference</h2>
        <References />
      </section>
      <nav
        aria-label="Previous and next"
        class="mt-12 flex flex-wrap justify-between gap-4 border-t border-ink pt-4"
      >
        {
          previous && (
            <a href={groupPath(previous)} rel="prev" class={NEIGHBOUR}>
              <span class="text-sm text-muted">Previous</span>
              <span class="font-display text-xl font-bold">{previous.label}</span>
            </a>
          )
        }
        {
          next && (
            <a href={groupPath(next)} rel="next" class:list={[NEIGHBOUR, "ms-auto text-end"]}>
              <span class="text-sm text-muted">Next</span>
              <span class="font-display text-xl font-bold">{next.label}</span>
            </a>
          )
        }
      </nav>
    </article>
  </PageColumns>
</Base>
