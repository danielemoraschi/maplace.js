---
import { getEntry, render } from "astro:content";
import {
  type ExampleGroup,
  groupDescription,
  groupHeading,
  groupPath,
} from "../examples/example-sections.ts";
import Base from "../layouts/Base.astro";
import { examplesMenu } from "../site/examples-menu.ts";
import type { NavLink } from "../site/nav-link.ts";
import ExampleList from "./ExampleList.astro";
import MarkdownLink from "./MarkdownLink.astro";
import NeighbourLinks from "./NeighbourLinks.astro";
import PageColumns from "./PageColumns.astro";

interface Props {
  group: ExampleGroup;
  previous: NavLink | undefined;
  next: NavLink | undefined;
}

const { group, previous, next } = Astro.props;
const reference = await getEntry("groupReferences", group.id);
if (reference === undefined) throw new Error(`the groupReferences collection has no ${group.id}`);
const { Content: References } = await render(reference);
---

{/* A category's hub (D31): its examples, each its own page, then the reference tables cut from the docs. */}
<Base heading={groupHeading(group)} description={groupDescription(group)}>
  <PageColumns navLabel="Examples" links={examplesMenu()} current={groupPath(group)} fold="wide">
    <article class="min-w-0">
      <h1 class="mt-0 mb-2 text-title">{groupHeading(group)}</h1>
      <p class="mt-0 mb-2 max-w-text text-lg text-muted">{group.intro}</p>
      <p class="mt-0 mb-0 text-sm"><MarkdownLink route={groupPath(group)} /></p>
      <section
        id="examples"
        aria-labelledby="examples-title"
        class="mt-12 border-t-3 border-ink pt-4"
      >
        <h2 id="examples-title" class="mt-0 mb-6 text-3xl">Examples</h2>
        <ExampleList group={group} />
      </section>
      <section
        id="reference"
        aria-labelledby="reference-title"
        class="doc-content mt-12 max-w-text border-t-3 border-ink pt-4"
      >
        <h2 id="reference-title" class="mt-0">Reference</h2>
        <References />
      </section>
      <NeighbourLinks previous={previous} next={next} />
    </article>
  </PageColumns>
</Base>
