---
interface Props {
  /** The id of the code, its Copy button's target. */
  id: string;
  /** What the code is for, describing its Copy button too. */
  label: string;
  /** The command or snippet. */
  text: string;
}

const { id, label, text } = Astro.props;
---

<div class="mb-4">
  <h3 id={`${id}-label`} class="mt-0 mb-1 text-sm font-medium">{label}</h3>
  <pre class="mt-0 mb-2 border-2 border-ink px-4 py-3 break-all whitespace-pre-wrap"><code id={id}>{text}</code></pre>
  <button type="button" class="button-plain" data-copy={id} aria-describedby={`${id}-label`}>
    Copy
  </button>
</div>
