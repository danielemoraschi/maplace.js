---
import { PRIVACY_PAGE } from "../site/footer-pages.ts";
import { GOOGLE_MAPS } from "../site/third-parties.ts";
---

<div
  class="absolute inset-0 grid place-content-center justify-items-center gap-3 bg-wash p-4 text-center in-data-[maps=on]:hidden"
>
  <p class="m-0 max-w-[26rem] text-md">
    These maps come from Google, which sees your IP address. They stay off until you say so, once
    for the whole site. <a href={`${PRIVACY_PAGE.route}#${GOOGLE_MAPS.id}`}>What loading sends to Google</a>
  </p>
  <button type="button" class="button" data-maps-grant>Load Google Maps</button>
</div>
