---
import type { ExampleFileLink } from "../examples/example-file-links.ts";

interface Props {
  /** What the files are to the example: "Fetches", "Styled by". */
  lead: string;
  links: readonly ExampleFileLink[];
}

const { lead, links } = Astro.props;
---

{
  links.length > 0 && (
    <p class="mt-1 mb-0 text-sm text-muted">
      {lead}{" "}
      {links.map(({ file, url }, index) => (
        <>
          {index > 0 && ", "}
          <a href={url} target="_blank" rel="noopener">{file}</a>
        </>
      ))}
    </p>
  )
}
