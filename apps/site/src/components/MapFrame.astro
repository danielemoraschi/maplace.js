---
import { SITE_MAPS_KEY } from "astro:env/server";
import { livePage } from "../examples/live-page.ts";
import ConsentPlaceholder from "./ConsentPlaceholder.astro";

interface Props {
  /** The example's page, whose map this runs. */
  html: string;
}

const { html } = Astro.props;
const page = livePage(html, SITE_MAPS_KEY);
/** The page calls `save(location)`, which the site writes: a note says what was saved. */
const savesEdits = html.includes("save(");
---

<div class="map-frame" data-live-page>
  <div class="page">
    <Fragment set:html={page} />
    {savesEdits && <p data-saved hidden />}
  </div>
  <p class="map-note loading">Loading the map…</p>
  <p class="map-note failed" data-map-failure>The map couldn't load.</p>
  <ConsentPlaceholder />
</div>

<style>
  .map-frame {
    position: relative;
    display: flex;
    flex-direction: column;
    height: clamp(18rem, 50vh, 28rem);
    border: var(--hairline);
    background: var(--wash);
  }
  .map-frame :global(maplace-map) {
    flex: 1 1 auto;
    min-height: 0;
  }
  /* The page's own nodes, laid out in the frame: its map, then tabs' details, polygon's note. */
  .page {
    display: contents;
  }
  .page > :global(:not(maplace-map, script)) {
    flex: none;
    margin: 0;
    padding: 0.5rem 0.75rem;
    border-top: var(--hairline);
    background: var(--paper);
    font-size: 0.875rem;
  }
  .page > :global(:empty:not(maplace-map)) {
    display: none;
  }
  .map-note {
    display: none;
    position: absolute;
    inset: auto auto 0.75rem 0.75rem;
    margin: 0;
    padding: 0.25rem 0.5rem;
    background: var(--paper);
    border: var(--hairline);
    font-size: 0.875rem;
  }
  .script-failed .failed {
    display: block;
  }
  .map-frame:has(:global(maplace-map:state(loading))) .loading,
  .map-frame:has(:global(maplace-map:state(error))) .failed {
    display: block;
  }
</style>
