---
import { SITE_MAPS_MAP_ID } from "astro:env/client";
import { SITE_MAPS_KEY } from "astro:env/server";
import {
  callsSave,
  type LiveVersionMarkup,
  liveVersions,
  shownFirst,
} from "../examples/live-versions.ts";
import ConsentPlaceholder from "./ConsentPlaceholder.astro";

interface Props {
  /** Its example's folder in `packages/maplace/examples/`. */
  name: string;
  /** Its list drawn its own way, kept out of the site's panel (`frame.css`). */
  drawsOwnList?: true | undefined;
  /** Why it runs on Google only: said, with a button to it, while MapLibre is chosen. */
  googleOnlyBecause?: string | undefined;
}

const { name, drawsOwnList, googleOnlyBecause } = Astro.props;
const settings = { apiKey: SITE_MAPS_KEY, mapId: SITE_MAPS_MAP_ID };
const versions = liveVersions(name, settings);
/** Whether `version` runs on Google, which the site has no key for. */
const keyMissing = ({ provider }: LiveVersionMarkup) =>
  provider === "google" && settings.apiKey === undefined;
const NOTE = "absolute bottom-3 left-3 m-0 border-2 border-ink bg-paper px-2 py-1 text-sm";
---

<div
  class="map-frame relative"
  data-own-list={drawsOwnList ? "" : undefined}
  data-no-version={versions.some(shownFirst) ? undefined : ""}
>
  {
    versions.map((version) => (
      <div
        class="version min-h-map"
        data-live-version={version.kind}
        data-provider={version.provider}
        data-maps-key-missing={keyMissing(version) ? "" : undefined}
        data-example={name}
        data-live-page={version.kind === "html" ? "" : undefined}
        hidden={!shownFirst(version)}
      >
        <Fragment set:html={version.markup} />
      </div>
    ))
  }
  {
    googleOnlyBecause && (
      <div class="hidden min-h-map place-content-center justify-items-center gap-3 bg-wash p-4 text-center in-data-no-version:grid">
        <p class="m-0 text-md">{googleOnlyBecause}</p>
        <button type="button" class="button-plain" data-show-on="google">Show it on Google</button>
      </div>
    )
  }
  {
    callsSave(name) && (
      <p class="m-0 border-t-2 border-ink bg-paper px-3 py-2 text-sm" data-saved hidden />
    )
  }
  <p class={`map-note loading ${NOTE}`}>Loading the map…</p>
  <p class={`map-note failed ${NOTE}`}>
    <span data-map-failure>The map couldn't load.</span>{" "}
    <button type="button" class="button-plain mt-1" data-map-reload>Reload the page</button>
  </p>
  <ConsentPlaceholder />
</div>
