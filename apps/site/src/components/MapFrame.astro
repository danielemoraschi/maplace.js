---
import { SITE_MAPS_KEY } from "astro:env/server";
import { callsSave, liveVersions } from "../examples/live-versions.ts";
import ConsentPlaceholder from "./ConsentPlaceholder.astro";

interface Props {
  /** Its example's folder in `packages/maplace/examples/`. */
  name: string;
}

const { name } = Astro.props;
const versions = liveVersions(name, SITE_MAPS_KEY);
const NOTE = "absolute bottom-3 left-3 m-0 border-2 border-ink bg-paper px-2 py-1 text-sm";
---

<div
  class="map-frame relative flex h-[clamp(18rem,50vh,28rem)] flex-col border-2 border-ink bg-wash"
  data-maps-key-missing={SITE_MAPS_KEY === undefined ? "" : undefined}>
  {
    versions.map(({ kind, markup }) => (
      <div
        class="version flex min-h-0 flex-[1_1_0] flex-col"
        data-live-version={kind}
        data-example={name}
        data-live-page={kind === "html" ? "" : undefined}
        hidden={kind !== "html"}
      >
        <Fragment set:html={markup} />
      </div>
    ))
  }
  {callsSave(name) && <p class="strip" data-saved hidden />}
  <p class={`map-note loading ${NOTE}`}>Loading the map…</p>
  <p class={`map-note failed ${NOTE}`} data-map-failure>The map couldn't load.</p>
  <ConsentPlaceholder />
</div>
