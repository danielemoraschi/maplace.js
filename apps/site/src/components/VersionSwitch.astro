---
import { exampleCode } from "../examples/example-sources.ts";

interface Props {
  /** Its example's folder in `packages/maplace/examples/`. */
  name: string;
}

const { name } = Astro.props;
---

<fieldset
  class="mx-0 mt-0 mb-2 flex flex-wrap items-baseline gap-x-3.5 gap-y-1 border-0 p-0 text-sm"
  data-version-switch={name}
>
  <legend class="float-left p-0 text-muted">Run the map from</legend>
  {
    exampleCode(name).map(({ kind, label }, index) => (
      <label class="inline-flex items-center gap-1">
        <input
          type="radio"
          name={`${name}-version`}
          value={kind}
          checked={index === 0}
          autocomplete="off"
        />
        {label}
      </label>
    ))
  }
</fieldset>
