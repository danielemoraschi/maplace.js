---
import { Image } from "astro:assets";
import { thumbnailOf } from "../examples/example-images.ts";
import { type ExampleGroup, examplePagesOf } from "../examples/example-sections.ts";

interface Props {
  group: ExampleGroup;
}

const { group } = Astro.props;
---

{/* A category's examples, each its picture and title linking its page, then its summary (W65). */}
<ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(12.5rem,1fr))] gap-x-5 gap-y-6 p-0">
  {
    examplePagesOf(group).map(({ section, path }) => {
      const thumbnail = thumbnailOf(section);
      return (
        <li>
          <a href={path} class="group grid gap-2 no-underline">
            {thumbnail && (
              <Image
                src={thumbnail}
                alt=""
                widths={[320, 640]}
                sizes="(min-width: 40rem) 20rem, 100vw"
                format="webp"
                loading="lazy"
                class="block aspect-[8/5] h-auto w-full rounded-[14px] border border-ink/15 bg-wash object-cover transition-colors group-hover:border-ink"
              />
            )}
            <span class="text-[1.0625rem] leading-tight font-semibold group-hover:underline">
              {section.title}
            </span>
          </a>
          <p class="mt-1.5 mb-0 text-md leading-snug text-muted">{section.summary}</p>
        </li>
      );
    })
  }
</ul>
