---
import { EXAMPLES_INTRO } from "../examples/examples-page.ts";
import { HOME_ROUTE } from "../examples/home-page.ts";
import ExampleCategories from "./ExampleCategories.astro";
import MarkdownLink from "./MarkdownLink.astro";
---

{/* The home page's index of every example (D31), as the examples page shows it (W72). */}
<section id="examples" aria-labelledby="examples-title" class="mt-12 border-t-3 border-ink pt-4">
  <h2 id="examples-title" class="m-0 text-3xl">Examples</h2>
  <p class="mt-2 mb-2 max-w-text text-lg text-muted">{EXAMPLES_INTRO}</p>
  <p class="mt-0 mb-8 text-sm"><MarkdownLink route={HOME_ROUTE} /></p>
  <ExampleCategories headingDepth={3} />
</section>
