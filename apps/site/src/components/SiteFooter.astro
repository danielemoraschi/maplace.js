---
import { FOOTER_PAGES } from "../site/footer-pages.ts";
import { REPOSITORY_URL } from "../site/repo-docs.ts";

const here = Astro.url.pathname;
---

{/* Held on the screen from 48rem up: on a phone it would take too much of it. */}
<footer class="mt-16 bg-ink text-sm text-paper min-[48rem]:sticky min-[48rem]:bottom-0 min-[48rem]:z-10">
  <div class="wrap flex flex-wrap justify-between gap-x-6 gap-y-2 py-4">
    <span>maplacejs · MIT licence</span>
    <span class="flex flex-wrap gap-x-5 gap-y-2">
      <button
        type="button"
        class="border-0 bg-transparent p-0 underline decoration-2 underline-offset-3"
        data-maps-toggle
      >
        <span class="in-data-[maps=on]:hidden">Maps: off<span class="max-[48rem]:sr-only"> · turn on</span></span>
        <span class="not-in-data-[maps=on]:hidden">Maps: on<span class="max-[48rem]:sr-only"> · turn off</span></span>
      </button>
      {
        FOOTER_PAGES.map(({ route, label }) => (
          <a
            href={route}
            aria-current={here === route ? "page" : undefined}
            class="aria-[current=page]:decoration-accent"
          >
            {label}
          </a>
        ))
      }
      <a href={REPOSITORY_URL}>GitHub</a>
    </span>
  </div>
</footer>
