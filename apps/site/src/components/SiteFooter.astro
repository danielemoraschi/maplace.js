---
import { copyrightYears } from "../site/copyright-years.ts";
import { FOOTER_PAGES } from "../site/footer-pages.ts";
import { REPOSITORY_URL } from "../site/repo-docs.ts";
import { SITE_MAINTAINER } from "../site/site-owner.ts";

interface Props {
  /** Its ground: the page's own paper, or the night band's under the home page (W66). */
  ground?: "light" | "night";
}

const { ground = "light" } = Astro.props;
const here = Astro.url.pathname;
const years = copyrightYears(new Date().getFullYear());
---

{/* At the end of the page, under a page shorter than the screen at its bottom (`Base.astro`). */}
<footer class:list={["border-t border-ink/15 text-sm", ground === "night" && "band-dark"]}>
  <div class="wrap flex flex-wrap justify-between gap-x-6 gap-y-2 py-4">
    <span>Maplace.js · Apache-2.0 licence © {years} {SITE_MAINTAINER}</span>
    <span class="flex flex-wrap gap-x-5 gap-y-2">
      <button
        type="button"
        class="border-0 bg-transparent p-0 underline decoration-2 underline-offset-3"
        data-maps-toggle
      >
        <span class="in-data-[maps=on]:hidden">Maps: off<span class="max-[48rem]:sr-only"> · turn on</span></span>
        <span class="not-in-data-[maps=on]:hidden">Maps: on<span class="max-[48rem]:sr-only"> · turn off</span></span>
      </button>
      {
        FOOTER_PAGES.map(({ route, label }) => (
          <a
            href={route}
            aria-current={here === route ? "page" : undefined}
            class="aria-[current=page]:decoration-accent"
          >
            {label}
          </a>
        ))
      }
      <a href={REPOSITORY_URL}>GitHub</a>
    </span>
  </div>
</footer>
