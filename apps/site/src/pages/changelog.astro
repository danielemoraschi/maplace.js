---
import { getEntry, render } from "astro:content";
import MarkdownLink from "../components/MarkdownLink.astro";
import ProsePage from "../components/ProsePage.astro";
import { CHANGELOG_ENTRY } from "../site/changelog-loader.ts";
import { CHANGELOG_PAGE } from "../site/footer-pages.ts";

const changelog = await getEntry("changelog", CHANGELOG_ENTRY);
if (changelog === undefined) {
  throw new Error("the changelog collection has no entry (content.config.ts)");
}
const { Content, headings } = await render(changelog);
const versions = headings.filter(({ depth }) => depth === 2);
---

<ProsePage
  title={CHANGELOG_PAGE.label}
  description={CHANGELOG_PAGE.description}
  contents={{ label: "Versions", headings: versions }}
>
  <Fragment slot="lede">
    Every change to the Maplace.js library that a reader would notice, newest first, with the issue it closed if any.
    Written in <a href={changelog.data.source}>CHANGELOG.md</a> with each change.
  </Fragment>
  <p class="mt-0 mb-6 text-sm"><MarkdownLink route={CHANGELOG_PAGE.route} /></p>
  <div class="changelog-entries"><Content /></div>
</ProsePage>
