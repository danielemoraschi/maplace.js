---
import { getEntry, render } from "astro:content";
import ProsePage from "../components/ProsePage.astro";
import { CHANGELOG_ENTRY } from "../site/changelog-loader.ts";
import { CHANGELOG_PAGE } from "../site/footer-pages.ts";

const changelog = await getEntry("changelog", CHANGELOG_ENTRY);
if (changelog === undefined) {
  throw new Error("the changelog collection has no entry (content.config.ts)");
}
const { Content } = await render(changelog);
---

<ProsePage
  title={CHANGELOG_PAGE.label}
  description="Every change to maplace a reader would notice, newest first."
>
  <Fragment slot="lede">
    Every change to maplace a reader would notice, newest first, with the issue it closed if any.
    Written in <a href={changelog.data.source}>CHANGELOG.md</a> with each change.
  </Fragment>
  <div class="entries"><Content /></div>
</ProsePage>

<style>
  .entries :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .entries :global(li) {
    margin: 0 0 0.875rem;
  }
  .entries :global(time) {
    margin-right: 0.5rem;
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.875rem;
  }
</style>
