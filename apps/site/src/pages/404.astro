---
import ProsePage from "../components/ProsePage.astro";
import { EXAMPLES_PAGE_ROUTE } from "../examples/example-sections.ts";
---

<ProsePage
  title="Page not found"
  description="There is no page of Maplace.js's site at this address."
>
  <Fragment slot="lede">
    There is no page at this address: it may have moved, or the link has a typo.
  </Fragment>
  <p>Start from <a href={EXAMPLES_PAGE_ROUTE}>the examples</a>, or pick a reference page from the menu above.</p>
</ProsePage>
