---
import { getCollection, render } from "astro:content";
import MarkdownLink from "../components/MarkdownLink.astro";
import PageColumns from "../components/PageColumns.astro";
import Base from "../layouts/Base.astro";
import { pageTitle } from "../site/head-meta-tags.ts";
import { docRoute, REPO_DOCS } from "../site/repo-docs.ts";

// A page per repo document the site renders (src/site/repo-docs.ts).
export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({ params: { doc: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
const sections = headings.filter(({ depth }) => depth === 2);
const links = REPO_DOCS.map(({ id, label }) => ({ href: docRoute(id), label }));
---

<Base title={pageTitle(doc.data.title)} description={doc.data.description}>
  <PageColumns
    navLabel="Documentation"
    links={links}
    current={docRoute(doc.id)}
    onThisPage={sections}
    fold="narrow"
  >
    <article class="doc-content">
      <h1 class="mt-0 mb-2 text-title">{doc.data.title}</h1>
      <p class="mt-0 mb-6 text-sm"><MarkdownLink route={docRoute(doc.id)} /></p>
      <Content />
    </article>
  </PageColumns>
</Base>
