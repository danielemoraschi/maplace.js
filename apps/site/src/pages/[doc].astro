---
import { getCollection, render } from "astro:content";
import DocsList from "../components/DocsList.astro";
import MarkdownLink from "../components/MarkdownLink.astro";
import Base from "../layouts/Base.astro";
import { docRoute } from "../site/repo-docs.ts";

// A page per repo document the site renders (src/site/repo-docs.ts).
export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({ params: { doc: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
const sections = headings.filter(({ depth }) => depth === 2);
const COLUMN_HEADING = "mt-0 mb-2 text-sm font-semibold";
---

<Base title={`${doc.data.title} · Maplace.js`} description={doc.data.description}>
  <div class="grid grid-cols-[13rem_minmax(0,1fr)] gap-10 pt-8 max-[800px]:grid-cols-[minmax(0,1fr)]">
    {/* The docs list scrolls away with the page; only the contents stay, so the two need no inner scroll. */}
    <div class="flex flex-col gap-y-8 max-[800px]:hidden">
      <nav aria-label="Documentation">
        <p aria-hidden="true" class={COLUMN_HEADING}>Documentation</p>
        <DocsList current={doc.id} />
      </nav>
      <nav aria-label="On this page" class="flex-1">
        <div class="sticky top-[calc(var(--spacing-header)+1.5rem)]">
          <p aria-hidden="true" class={COLUMN_HEADING}>On this page</p>
          <ol class="m-0 list-none border-l-3 border-ink pl-4 text-sm leading-[2]">
            {
              sections.map(({ slug, text }) => (
                <li>
                  <a href={`#${slug}`} class="no-underline">
                    {text}
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
      </nav>
    </div>
    <nav aria-label="Documentation" class="hidden max-[800px]:block">
      <details class="border-b border-ink pb-2">
        <summary class="cursor-pointer text-sm font-semibold">Documentation</summary>
        <div class="mt-2">
          <DocsList current={doc.id} />
        </div>
      </details>
    </nav>
    <article class="doc-content max-w-text">
      <h1 class="mt-0 mb-2 text-title">{doc.data.title}</h1>
      <p class="mt-0 mb-6 text-sm"><MarkdownLink route={docRoute(doc.id)} /></p>
      <Content />
    </article>
  </div>
</Base>
