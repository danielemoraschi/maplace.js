---
import { getCollection, render } from "astro:content";
import MarkdownLink from "../components/MarkdownLink.astro";
import Base from "../layouts/Base.astro";
import { docRoute } from "../site/repo-docs.ts";

// A page per repo document the site renders (src/site/repo-docs.ts).
export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({ params: { doc: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
const sections = headings.filter(({ depth }) => depth === 2);
---

<Base title={`${doc.data.title} · maplacejs`} description={doc.data.description}>
  <div class="grid grid-cols-[13rem_minmax(0,1fr)] gap-10 pt-8 max-[800px]:grid-cols-[minmax(0,1fr)]">
    <nav aria-label="On this page" class="max-[800px]:hidden">
      <ol class="sticky top-[calc(var(--spacing-header)+1.5rem)] m-0 list-none border-l-3 border-ink pl-4 text-sm leading-[2]">
        {
          sections.map(({ slug, text }) => (
            <li>
              <a href={`#${slug}`} class="no-underline">
                {text}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <article class="doc-content max-w-text">
      <h1 class="mt-0 mb-2 text-title">{doc.data.title}</h1>
      <p class="mt-0 mb-6 text-sm"><MarkdownLink route={docRoute(doc.id)} /></p>
      <Content />
    </article>
  </div>
</Base>
