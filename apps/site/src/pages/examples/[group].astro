---
import ExampleGroupPage from "../../components/ExampleGroupPage.astro";
import { EXAMPLE_GROUPS, type ExampleGroup } from "../../examples/example-sections.ts";

/** Every feature's page. */
export function getStaticPaths() {
  return EXAMPLE_GROUPS.map((group) => ({ params: { group: group.id }, props: { group } }));
}

const { group } = Astro.props as { group: ExampleGroup };
---

<ExampleGroupPage group={group} />
