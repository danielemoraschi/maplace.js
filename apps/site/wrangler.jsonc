// The site as static assets, and one script run first for the star count (W44: `src/worker/`), so
// visitors' browsers ask the site, never GitHub; every other path is the assets'. Its GitHub token
// is the Worker's secret GITHUB_STARS_TOKEN, set once (`wrangler versions secret put`).
// workers_dev off, so the Worker's own workers.dev address serves nothing; preview_urls on, for
// the `next` alias CI uploads; observability off, so no visitor's request is logged for the site.
// Only `wrangler deploy` applies these three (`wrangler triggers deploy` the first two), never
// CI's `versions upload`: the Worker was created in Cloudflare's dashboard, all three set there.
{
  "name": "maplacejs",
  "compatibility_date": "2026-10-13",
  "main": "./src/worker/worker.ts",
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": false },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/stars"]
  }
}
