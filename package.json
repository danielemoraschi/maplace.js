{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "typecheck": "tsc && tsc -p scripts",
    "check": "biome check && node scripts/check.ts",
    "fix": "biome check --write",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/google.maps": "^3.66.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
