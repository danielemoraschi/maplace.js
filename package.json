{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "typecheck": "tsc && tsc -p scripts && tsc -p apps/site",
    "check": "biome check && node scripts/check.ts",
    "fix": "biome check --write",
    "test": "vitest run --coverage",
    "sonar": "node --env-file-if-exists=.env.local node_modules/.bin/sonar-scanner-npm",
    "sizes": "node scripts/sizes.ts",
    "build": "node scripts/build.ts",
    "coverage": "node scripts/coverage.ts",
    "release": "node scripts/release.ts",
    "release-notes": "node scripts/release-notes.ts",
    "release-cdn": "node scripts/release-cdn.ts",
    "site:dev": "npm run dev -w site",
    "site:build": "npm run build -w site"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@astrojs/compiler-rs": "0.5.2",
    "@biomejs/biome": "^2.6.6",
    "@sonar/scan": "^5.0.2",
    "@types/google.maps": "^3.66.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supercluster": "7.1.3",
    "@vitejs/plugin-rsc": "0.5.39",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "maplibre-gl": "^6.16.0",
    "playwright": "1.65.0",
    "publint": "0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.57.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@sonar/scan": {
      "node-forge": "1.4.3"
    }
  }
}
