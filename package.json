{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "typecheck": "tsc && tsc -p scripts",
    "check": "biome check && node scripts/check.ts",
    "fix": "biome check --write",
    "test": "vitest run --coverage",
    "sonar": "node --env-file-if-exists=.env.local node_modules/.bin/sonar-scanner-npm",
    "sizes": "node scripts/sizes.ts",
    "build": "node scripts/build.ts",
    "coverage": "node scripts/coverage.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@sonar/scan": "^5.0.1",
    "@types/google.maps": "^3.66.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "playwright": "1.63.0",
    "publint": "0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
